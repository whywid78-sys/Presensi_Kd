        function applyAdminFilter() {
            const startStr = document.getElementById('filter-start').value; const endStr = document.getElementById('filter-end').value;
            const unitFilter = document.getElementById('filter-unit').value;
            
            let joinedData = window.presensiData.map(record => {
                let pegawai = window.masterASN.find(m => m.nip === record.username);
                // Dukungan data error lama di tabel Admin
                return { 
                    ...record, 
                    namaBaru: pegawai ? pegawai.nama : record.username, 
                    unitBaru: pegawai ? pegawai.unitKerja : '-',
                    jamMasuk: record.jamMasuk || (record.tipe === 'masuk' ? record.waktu : null),
                    jamPulang: record.jamPulang || (record.tipe === 'pulang' ? record.waktu : null),
                    lokasiMasuk: record.lokasiMasuk || (record.tipe === 'masuk' || record.tipe === 'izin' ? record.lokasi : null),
                    lokasiPulang: record.lokasiPulang || (record.tipe === 'pulang' ? record.lokasi : null),
                    status: record.status || "-",
                    fotoMasuk: record.fotoMasuk || (record.tipe === 'masuk' || record.tipe === 'izin' ? record.foto : null),
                    fotoPulang: record.fotoPulang || (record.tipe === 'pulang' ? record.foto : null)
                };
            });

            if (startStr && endStr) {
                const startDT = new Date(startStr).getTime(); const endDT = new Date(endStr).getTime();
                joinedData = joinedData.filter(d => { const dTime = new Date(d.tanggal).getTime(); return dTime >= startDT && dTime <= endDT; });
            }
            if (unitFilter !== 'ALL') joinedData = joinedData.filter(d => d.unitBaru === unitFilter);

            joinedData.sort((a,b) => {
                let da = new Date(a.tanggal + 'T' + (a.jamMasuk || a.waktu || '00:00')).getTime();
                let db = new Date(b.tanggal + 'T' + (b.jamMasuk || b.waktu || '00:00')).getTime();
                return db - da;
            });
            
            window.currentFilteredData = joinedData; 
            renderAdminStatistik(joinedData);
        }


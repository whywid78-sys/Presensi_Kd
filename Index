    <script>
        // 1. Generate & Inject Manifest dynamically
        const manifestData = {
            name: "Sistem Presensi ASN",
            short_name: "Presensi",
            description: "Sistem Kehadiran Berbasis Firebase",
            start_url: location.href,
            display: "standalone",
            background_color: "#f3f4f6",
            theme_color: "#1d4ed8",
            icons: [
                {
                    src: "https://upload.wikimedia.org/wikipedia/commons/1/1a/Logo_Kementerian_Dalam_Negeri_Republik_Indonesia.png",
                    sizes: "192x192",
                    type: "image/png"
                },
                {
                    src: "https://upload.wikimedia.org/wikipedia/commons/1/1a/Logo_Kementerian_Dalam_Negeri_Republik_Indonesia.png",
                    sizes: "512x512",
                    type: "image/png"
                }
            ]
        };
        // Menggunakan Data URI untuk manifest
        const manifestString = encodeURIComponent(JSON.stringify(manifestData));
        const manifestUrl = 'data:application/json;charset=utf-8,' + manifestString;
        const manifestLink = document.createElement('link');
        manifestLink.rel = 'manifest';
        manifestLink.href = manifestUrl;
        document.head.appendChild(manifestLink);

        // CATATAN: Service Worker tidak bisa didaftarkan menggunakan Blob URL 
        // karena kebijakan keamanan browser (harus berupa file HTTPS fisik).
        // Blok registrasi Service Worker telah dihapus untuk menghilangkan error.

        // 2. Handle PWA Installation Prompt
        let deferredPrompt;
        window.addEventListener('beforeinstallprompt', (e) => {
            e.preventDefault();
            deferredPrompt = e;
            // Tampilkan tombol install
            const installBtn = document.getElementById('btn-install-pwa');
            if (installBtn) installBtn.classList.remove('hidden');
        });

        window.installPWA = async () => {
            if (deferredPrompt) {
                deferredPrompt.prompt();
                const { outcome } = await deferredPrompt.userChoice;
                if (outcome === 'accepted') {
                    console.log('PWA Installed successfully');
                }
                deferredPrompt = null;
                document.getElementById('btn-install-pwa').classList.add('hidden');
            }
        };
    </script>

    <!-- MAIN LOGIC JAVASCRIPT DENGAN FIREBASE SDK -->
    <script type="module">
        import { initializeApp } from "https://www.gstatic.com/firebasejs/11.6.1/firebase-app.js";
        import { getFirestore, collection, doc, setDoc, getDocs, deleteDoc, query } from "https://www.gstatic.com/firebasejs/11.6.1/firebase-firestore.js";
        import { getAuth, signInAnonymously, signInWithCustomToken, onAuthStateChanged } from "https://www.gstatic.com/firebasejs/11.6.1/firebase-auth.js";

        // ====================================================================
        // 1. KONFIGURASI FIREBASE
        // ====================================================================
        
        let firebaseConfig;
        const isCanvas = typeof __firebase_config !== 'undefined';
        
        if (isCanvas) {
            firebaseConfig = JSON.parse(__firebase_config);
        } else {
            firebaseConfig = {
              apiKey: "AIzaSyArxNVCamAlCBT9S_mSUYCy0aptC08JVQg",
              authDomain: "whywid-database.firebaseapp.com",
              projectId: "whywid-database",
              storageBucket: "whywid-database.firebasestorage.app",
              messagingSenderId: "100991368805",
              appId: "1:100991368805:web:c598f9da212f81005d108c",
              measurementId: "G-83P7GK1YS7"
            };
        }

        const app = initializeApp(firebaseConfig);
        const auth = getAuth(app);
        const db = getFirestore(app);
        const appId = isCanvas && typeof __app_id !== 'undefined' ? __app_id : 'default-app-id';

        function getCollectionPath(colName) {
            return isCanvas ? `artifacts/${appId}/public/data/${colName}` : colName;
        }

        async function fetchWithTimeout() {
            const fetchPromise = (async () => {
                const master = [];
                const snapM = await getDocs(query(collection(db, getCollectionPath('MASTER_ASN'))));
                snapM.forEach(d => master.push(d.data()));

                const presensi = [];
                const snapP = await getDocs(query(collection(db, getCollectionPath('LOG_PRESENSI'))));
                snapP.forEach(d => presensi.push(d.data()));

                let settings = {
                    hariKerja: [1, 2, 3, 4, 5],
                    jadwal: {
                        1: { aktif: true, masukMulai: '06:00', masukAkhir: '08:00', pulangMulai: '16:00', pulangAkhir: '18:00' },
                        2: { aktif: true, masukMulai: '06:00', masukAkhir: '08:00', pulangMulai: '16:00', pulangAkhir: '18:00' },
                        3: { aktif: true, masukMulai: '06:00', masukAkhir: '08:00', pulangMulai: '16:00', pulangAkhir: '18:00' },
                        4: { aktif: true, masukMulai: '06:00', masukAkhir: '08:00', pulangMulai: '16:00', pulangAkhir: '18:00' },
                        5: { aktif: true, masukMulai: '06:00', masukAkhir: '08:00', pulangMulai: '16:30', pulangAkhir: '18:30' },
                        6: { aktif: false, masukMulai: '', masukAkhir: '', pulangMulai: '', pulangAkhir: '' },
                        0: { aktif: false, masukMulai: '', masukAkhir: '', pulangMulai: '', pulangAkhir: '' }
                    }
                };
                
                const snapS = await getDocs(query(collection(db, getCollectionPath('PENGATURAN'))));
                snapS.forEach(d => {
                    if (d.id === 'app_settings') {
                        try { settings = JSON.parse(d.data().JSON_Value); } catch(e){}
                    }
                });

                if (master.length === 0) {
                    master.push({ nip: 'admin', nama: 'Administrator Sistem', unitKerja: 'Pusat Data', role: 'admin', password: 'admin', lat: '', lng: '', radius: '' });
                    await setDoc(doc(db, getCollectionPath('MASTER_ASN'), 'admin'), master[0]);
                }
                return { master, presensi, settings };
            })();

            const timeoutPromise = new Promise((_, reject) => setTimeout(() => reject(new Error("TIMEOUT_DB")), 10000));
            return Promise.race([fetchPromise, timeoutPromise]);
        }

        async function firebaseCall(method, ...args) {
            if (!auth.currentUser) throw new Error("Akses Database Ditolak (Belum Login Firebase).");

            if (method === 'getSemuaData') {
                return await fetchWithTimeout();
            } else if (method === 'simpanDataASN') {
                await setDoc(doc(db, getCollectionPath('MASTER_ASN'), args[0].nip), args[0]);
                return true;
            } else if (method === 'hapusDataASN') {
                await deleteDoc(doc(db, getCollectionPath('MASTER_ASN'), args[0]));
                return true;
            } else if (method === 'simpanPengaturan') {
                await setDoc(doc(db, getCollectionPath('PENGATURAN'), 'app_settings'), { JSON_Value: JSON.stringify(args[0]) });
                return true;
            } else if (method === 'simpanDataPresensi') {
                
                // --- PERBAIKAN STRUKTUR DATA AGAR TERBACA OLEH KARTU STATUS ---
                const payload = args[0];
                let existing = window.presensiData.find(p => p.tanggal === payload.tanggal && p.username === payload.username);
                
                if (payload.tipe === 'masuk') {
                    if (existing) return { success: false, message: "Anda sudah melakukan presensi masuk hari ini!" };
                    
                    // Merubah format mentah dari kamera menjadi format Standar Database
                    const docData = {
                        id: payload.id, 
                        username: payload.username, 
                        tanggal: payload.tanggal,
                        jamMasuk: payload.waktu, 
                        lokasiMasuk: payload.lokasi, 
                        status: payload.status, 
                        fotoMasuk: payload.foto
                    };
                    await setDoc(doc(db, getCollectionPath('LOG_PRESENSI'), payload.id), docData);

                } else if (payload.tipe === 'pulang') {
                    if (existing) {
                        existing.jamPulang = payload.waktu; 
                        existing.statusPulang = payload.status; 
                        existing.lokasiPulang = payload.lokasi; 
                        existing.fotoPulang = payload.foto;
                        await setDoc(doc(db, getCollectionPath('LOG_PRESENSI'), existing.id), existing);
                    } else {
                        // Jika memaksa absen pulang tapi belum absen masuk
                        const docData = {
                            id: payload.id, 
                            username: payload.username, 
                            tanggal: payload.tanggal,
                            jamMasuk: "-", 
                            lokasiMasuk: "-", 
                            status: "Tanpa Masuk", 
                            jamPulang: payload.waktu, 
                            lokasiPulang: payload.lokasi, 
                            statusPulang: payload.status,
                            fotoPulang: payload.foto
                        };
                        await setDoc(doc(db, getCollectionPath('LOG_PRESENSI'), payload.id), docData);
                    }
                } else if (payload.tipe === 'izin') {
                    if (existing) return { success: false, message: "Anda sudah memiliki riwayat presensi hari ini!" };
                    const docData = {
                        id: payload.id, 
                        username: payload.username, 
                        tanggal: payload.tanggal,
                        jamMasuk: "-",
                        status: payload.status, 
                        lokasiMasuk: payload.lokasi, // Menyimpan alasan izin
                        fotoMasuk: payload.foto
                    };
                    await setDoc(doc(db, getCollectionPath('LOG_PRESENSI'), payload.id), docData);
                }
                return { success: true, message: "Berhasil disimpan" };

            } else if (method === 'resetPresensiData') {
                const snapP = await getDocs(query(collection(db, getCollectionPath('LOG_PRESENSI'))));

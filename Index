<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>Sistem Presensi ASN Terintegrasi Firebase</title>
    
    <!-- PWA Meta Tags -->
    <meta name="theme-color" content="#1d4ed8">
    <link rel="apple-touch-icon" href="https://upload.wikimedia.org/wikipedia/commons/1/1a/Logo_Kementerian_Dalam_Negeri_Republik_Indonesia.png">

    <!-- Menggunakan Tailwind CSS untuk UI Modern & Responsive -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- SheetJS untuk Fitur Export Excel -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js"></script>
    
    <style>
        /* OVERRIDE BLOGGER STYLES */
        body, html { margin: 0; padding: 0; height: 100%; width: 100%; background-color: #f3f4f6; overflow: hidden; }
        #blogger-override-wrapper { position: fixed; top: 0; left: 0; right: 0; bottom: 0; z-index: 999999; background: #f3f4f6; overflow-y: auto; overflow-x: hidden;}
        
        /* Custom Styles & Animations */
        @import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600;700&display=swap');
        #blogger-override-wrapper { font-family: 'Inter', sans-serif; }
        
        .fade-in { animation: fadeIn 0.3s ease-in-out; }
        @keyframes fadeIn { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: translateY(0); } }
        
        /* Video Container Fix */
        video { width: 100%; height: 100%; object-fit: cover; display: block; }
        canvas { display: none; }
        
        /* Toast Notification */
        .toast { position: fixed; top: 20px; left: 50%; transform: translateX(-50%); padding: 1rem 2rem; border-radius: 2rem; color: white; opacity: 0; transition: opacity 0.3s, transform 0.3s; z-index: 9999999; width: max-content; max-width: 90%; pointer-events: none; box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.2); font-weight: bold; text-align: center; font-size: 0.875rem; }
        .toast.show { opacity: 1; transform: translate(-50%, 10px); }
        .toast-success { background-color: #10b981; }
        .toast-error { background-color: #ef4444; }
        
        /* Custom Scrollbar */
        ::-webkit-scrollbar { width: 6px; }
        ::-webkit-scrollbar-track { background: transparent; }
        ::-webkit-scrollbar-thumb { background: #cbd5e1; border-radius: 10px; }
        ::-webkit-scrollbar-thumb:hover { background: #94a3b8; }
        
        /* Tab Admin Styles */
        .tab-btn { border-bottom: 2px solid transparent; transition: all 0.3s; }
        .tab-btn.active { border-bottom: 2px solid #2563eb; color: #2563eb; font-weight: 700; }
    </style>
</head>
<body>
    <!-- WRAPPER UTAMA (MENIMPA BLOGGER) -->
    <div id="blogger-override-wrapper" class="text-gray-800 antialiased">
        
        <!-- Toast Notification -->
        <div id="toast" class="toast"></div>

        <!-- NATIVE CAMERA FALLBACK -->
        <input type="file" accept="image/*" capture="user" id="fallback-camera-input" class="hidden" onchange="handleFallbackCamera(event)">

        <!-- MAIN APP CONTAINER -->
        <div id="app" class="min-h-screen flex flex-col max-w-md mx-auto bg-white shadow-2xl relative">
            
            <!-- HEADER -->
            <header class="bg-blue-700 text-white p-4 shadow-md flex justify-between items-center z-10 hidden" id="app-header">
                <div>
                    <h1 class="text-lg font-bold flex items-center gap-2">
                        <img src="https://upload.wikimedia.org/wikipedia/commons/1/1a/Logo_Kementerian_Dalam_Negeri_Republik_Indonesia.png" alt="Logo" class="w-7 h-7 object-contain bg-white rounded-full p-0.5 shadow-sm" onerror="this.style.display='none'">
                        Presensi ASN
                        <span class="bg-yellow-400 w-2 h-2 rounded-full inline-block animate-pulse" title="Tersambung ke Firebase"></span>
                    </h1>
                    <p class="text-xs text-blue-200 mt-0.5" id="header-username">Memuat profil...</p>
                </div>
                <button onclick="logout()" class="text-xs bg-blue-800 hover:bg-blue-900 px-3 py-1.5 rounded-lg transition border border-blue-600 font-semibold shadow-inner">Logout</button>
            </header>

            <!-- VIEW: LOGIN -->
            <div id="view-login" class="flex-1 flex flex-col justify-center p-6 fade-in bg-gradient-to-b from-blue-50 to-white">
                <div class="text-center mb-8">
                    <img src="https://iili.io/BgH5HyN.webp" 
                         alt="Logo Instansi" 
                         class="w-24 h-24 object-contain mx-auto mb-4 drop-shadow-xl transition-transform hover:scale-105"
                         onerror="this.src='https://ui-avatars.com/api/?name=Presensi+ASN&background=2563eb&color=fff&size=128&rounded=true'">
                    <h2 class="text-2xl font-bold text-gray-800 tracking-tight">E_PRESENSI ASN</h2>
                    <p class="text-blue-500 text-sm mt-1">DINAS PENDIDIKAN DAN KEBUDAYAAN KAB. NGAWI</p>
                    <p class="text-blue-500 text-sm mt-1">KORWIL KEDUNGGALAR</p>
                </div>
                <div class="space-y-4 bg-white p-6 rounded-2xl shadow-sm border border-gray-100">
                    <div>
                        <label class="block text-xs font-bold text-gray-700 mb-1.5 uppercase tracking-wide">NIP / Username</label>
                        <input type="text" id="login-username" class="w-full border border-gray-300 rounded-xl p-3 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition text-sm bg-gray-50" placeholder="Masukkan NIP">
                    </div>
                    <div>
                        <label class="block text-xs font-bold text-gray-700 mb-1.5 uppercase tracking-wide">Password</label>
                        <input type="password" id="login-password" class="w-full border border-gray-300 rounded-xl p-3 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition text-sm bg-gray-50" placeholder="••••••••">
                    </div>
                    <button id="btn-login-submit" onclick="login()" class="w-full mt-4 bg-blue-600 hover:bg-blue-700 text-white font-bold py-3 rounded-xl shadow-md transition transform active:scale-95 disabled:opacity-70 disabled:cursor-wait flex justify-center items-center">
                        <span id="login-text">Masuk ke Sistem</span>
                        <svg id="login-spinner" class="animate-spin ml-2 h-5 w-5 text-white hidden" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path></svg>
                    </button>

                    <!-- Tombol Install PWA (Akan Muncul Jika Didukung Browser) -->
                    <button id="btn-install-pwa" onclick="installPWA()" class="hidden w-full mt-2 bg-emerald-600 hover:bg-emerald-700 text-white font-bold py-3 rounded-xl shadow-md transition transform active:scale-95 flex justify-center items-center text-sm">
                        <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"></path></svg>
                        Install Aplikasi (PWA)
                    </button>
                </div>
            </div>

            <!-- VIEW: DASHBOARD USER -->
            <div id="view-dashboard" class="flex-1 p-4 hidden fade-in overflow-y-auto pb-8 bg-gray-50">
                
                <!-- Profil ASN -->
                <div class="bg-white border border-gray-100 rounded-2xl p-4 shadow-sm mb-5 flex items-center space-x-4">
                    <div class="w-14 h-14 bg-gradient-to-br from-blue-100 to-blue-200 text-blue-700 rounded-full flex items-center justify-center font-bold text-2xl shrink-0 border-2 border-white shadow-sm">
                        <span id="profile-initial">A</span>
                    </div>
                    <div class="overflow-hidden flex-1">
                        <h2 class="font-bold text-gray-800 text-lg leading-tight truncate" id="profile-name">Nama Pegawai</h2>
                        <p class="text-sm text-blue-600 font-semibold truncate" id="profile-unit">Unit Kerja</p>
                        <p class="text-xs text-gray-400 font-mono mt-0.5 truncate" id="profile-nip">NIP: 12345</p>
                    </div>
                </div>

                <!-- Realtime Clock -->
                <div class="bg-gradient-to-br from-blue-600 via-blue-700 to-indigo-800 rounded-2xl p-6 text-white text-center shadow-lg mb-5 relative overflow-hidden">
                    <div class="absolute -right-10 -top-10 w-32 h-32 bg-white opacity-5 rounded-full blur-2xl"></div>
                    <p class="text-sm font-medium opacity-90" id="current-date">Memuat Tanggal...</p>
                    <h2 class="text-5xl font-extrabold my-2 tracking-tight drop-shadow-md font-mono" id="current-time">00:00:00</h2>
                    <div class="bg-black/20 inline-flex items-center px-3 py-1.5 rounded-full mt-2 border border-white/10 text-xs backdrop-blur-sm">
                        <span id="location-status">📍 Menunggu sinyal GPS...</span>
                    </div>
                </div>

                <!-- Info Lokasi & Aturan Jam Kerja -->
                <div id="office-info-card" class="bg-white border border-blue-100 rounded-2xl p-4 shadow-sm mb-5 hidden">
                    <h3 class="font-bold text-gray-800 border-b border-gray-100 pb-2 mb-3 text-sm flex items-center">
                        <svg class="w-4 h-4 mr-1.5 text-blue-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path></svg>
                        Informasi Kantor & Aturan
                    </h3>
                    <div class="grid grid-cols-2 gap-3 text-xs">
                        <div class="bg-gray-50 p-2 rounded-lg border border-gray-100">
                            <span class="font-bold block text-[10px] text-gray-500 uppercase tracking-wide mb-1">Koordinat:</span>
                            <span id="office-coords" class="font-mono text-blue-600 font-semibold break-all">-</span>
                        </div>
                        <div class="bg-gray-50 p-2 rounded-lg border border-gray-100">
                            <span class="font-bold block text-[10px] text-gray-500 uppercase tracking-wide mb-1">Radius Izin:</span>
                            <span id="office-radius" class="font-bold text-gray-800">-</span>
                        </div>
                        <div class="col-span-2 mt-1">
                            <span class="font-bold block text-[10px] text-gray-500 uppercase tracking-wide mb-1.5">Jadwal Kehadiran:</span>
                            <div id="office-workhours" class="bg-blue-50 p-2.5 rounded-lg border border-blue-100">-</div>
                        </div>
                        <div class="col-span-2 mt-1 p-3 bg-gradient-to-r from-gray-50 to-white rounded-lg border border-gray-200 flex justify-between items-center shadow-inner">
                            <span class="font-semibold text-gray-600 flex items-center"><svg class="w-4 h-4 mr-1 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"></path></svg> Jarak Saat Ini:</span>
                            <span id="user-distance" class="text-sm font-bold text-gray-400">Menghitung...</span>
                        </div>
                    </div>
                </div>

                <!-- Status Hari Ini -->
                <div class="bg-white border border-gray-100 rounded-2xl p-4 shadow-sm mb-5">
                    <h3 class="font-bold text-gray-800 mb-3 text-sm">Status Hari Ini</h3>
                    <div class="flex justify-between items-center bg-gray-50 p-2.5 rounded-lg mb-2 border border-gray-100">
                        <span class="text-sm font-medium text-gray-600 flex items-center"><svg class="w-4 h-4 mr-2 text-green-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 16l-4-4m0 0l4-4m-4 4h14m-5 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h7a3 3 0 013 3v1"></path></svg> Masuk</span>
                        <span id="status-masuk" class="text-sm font-bold text-gray-400">Belum Absen</span>
                    </div>
                    <div class="flex justify-between items-center bg-gray-50 p-2.5 rounded-lg border border-gray-100">
                        <span class="text-sm font-medium text-gray-600 flex items-center"><svg class="w-4 h-4 mr-2 text-orange-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"></path></svg> Pulang</span>
                        <span id="status-pulang" class="text-sm font-bold text-gray-400">Belum Absen</span>
                    </div>
                </div>

                <!-- Action Buttons -->
                <div class="grid grid-cols-2 gap-3 mb-6">
                    <button id="btn-masuk" onclick="openCamera('masuk')" class="group relative overflow-hidden flex flex-col items-center justify-center bg-white border-2 border-green-500 text-green-600 p-4 rounded-2xl transition-all shadow-sm transform active:scale-95 disabled:opacity-50 disabled:cursor-not-allowed hover:bg-green-50">
                        <div class="bg-green-100 p-2 rounded-full mb-2 group-hover:scale-110 transition-transform"><svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 16l-4-4m0 0l4-4m-4 4h14m-5 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h7a3 3 0 013 3v1"></path></svg></div>
                        <span class="font-bold text-sm">Absen Masuk</span>
                    </button>
                    <button id="btn-pulang" onclick="openCamera('pulang')" class="group relative overflow-hidden flex flex-col items-center justify-center bg-white border-2 border-orange-400 text-orange-600 p-4 rounded-2xl transition-all shadow-sm transform active:scale-95 disabled:opacity-50 disabled:cursor-not-allowed hover:bg-orange-50">
                        <div class="bg-orange-100 p-2 rounded-full mb-2 group-hover:scale-110 transition-transform"><svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"></path></svg></div>
                        <span class="font-bold text-sm">Absen Pulang</span>
                    </button>
                    <button id="btn-izin" onclick="bukaModalIzin()" class="col-span-2 group relative overflow-hidden flex items-center justify-center bg-white border-2 border-purple-400 text-purple-600 p-3 rounded-2xl transition-all shadow-sm transform active:scale-95 disabled:opacity-50 disabled:cursor-not-allowed hover:bg-purple-50">
                        <div class="bg-purple-100 p-1.5 rounded-full mr-2 group-hover:scale-110 transition-transform"><svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path></svg></div>
                        <span class="font-bold text-sm">Ajukan Izin / Cuti / Dinas</span>
                    </button>
                </div>
            </div>

            <!-- VIEW: DASHBOARD ADMIN -->
            <div id="view-admin" class="flex-1 hidden fade-in overflow-y-auto bg-gray-50 flex-col pb-8">
                
                <!-- Admin Navigation Tabs -->
                <div class="bg-white shadow-sm flex px-2 pt-2 sticky top-0 z-10">
                    <button onclick="switchAdminTab('statistik')" id="tab-statistik" class="tab-btn active flex-1 py-3 text-center text-sm font-bold text-gray-500 hover:text-blue-600">📊 Statistik Data</button>
                    <button onclick="switchAdminTab('pengaturan')" id="tab-pengaturan" class="tab-btn flex-1 py-3 text-center text-sm font-bold text-gray-500 hover:text-blue-600">⚙️ Pengaturan & ASN</button>
                </div>

                <div class="p-4 flex-1">
                    
                    <!-- SUB-VIEW: STATISTIK PRESENSI -->
                    <div id="admin-sec-statistik" class="fade-in space-y-4">
                        
                        <!-- Filters -->
                        <div class="bg-white border border-gray-100 rounded-2xl p-4 shadow-sm">
                            <h3 class="text-sm font-bold text-gray-800 mb-3 flex items-center"><svg class="w-4 h-4 mr-1.5 text-blue-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 4a1 1 0 011-1h16a1 1 0 011 1v2.586a1 1 0 01-.293.707l-6.414 6.414a1 1 0 00-.293.707V17l-4 4v-6.586a1 1 0 00-.293-.707L3.293 7.293A1 1 0 013 6.586V4z"></path></svg>Filter Log Presensi</h3>
                            <div class="grid grid-cols-2 gap-3 mb-3">
                                <div>
                                    <label class="text-[10px] font-bold text-gray-500 uppercase tracking-wide block mb-1">Dari Tanggal</label>
                                    <input type="date" id="filter-start" class="w-full border border-gray-200 rounded-lg p-2 text-sm text-gray-700 focus:ring-2 focus:ring-blue-500 outline-none" onchange="applyAdminFilter()">
                                </div>
                                <div>
                                    <label class="text-[10px] font-bold text-gray-500 uppercase tracking-wide block mb-1">Sampai Tanggal</label>
                                    <input type="date" id="filter-end" class="w-full border border-gray-200 rounded-lg p-2 text-sm text-gray-700 focus:ring-2 focus:ring-blue-500 outline-none" onchange="applyAdminFilter()">
                                </div>
                            </div>
                            <div>
                                <label class="text-[10px] font-bold text-gray-500 uppercase tracking-wide block mb-1">Filter Unit Kerja</label>
                                <select id="filter-unit" class="w-full border border-gray-200 rounded-lg p-2.5 text-sm text-gray-700 focus:ring-2 focus:ring-blue-500 outline-none bg-gray-50" onchange="applyAdminFilter()">
                                    <option value="ALL">-- Tampilkan Semua Unit --</option>
                                </select>
                            </div>
                        </div>

                        <!-- Statistics Cards -->
                        <div class="grid grid-cols-2 gap-3">
                            <div class="bg-blue-50 border border-blue-100 p-3 rounded-xl text-center shadow-sm">
                                <p class="text-[10px] text-blue-600 font-bold mb-1 uppercase tracking-widest">Hadir</p>
                                <p class="text-2xl font-extrabold text-blue-800" id="stat-total">0</p>
                            </div>
                            <div class="bg-green-50 border border-green-100 p-3 rounded-xl text-center shadow-sm">
                                <p class="text-[10px] text-green-600 font-bold mb-1 uppercase tracking-widest">Tepat</p>
                                <p class="text-2xl font-extrabold text-green-800" id="stat-tepat">0</p>
                            </div>
                            <div class="bg-red-50 border border-red-100 p-3 rounded-xl text-center shadow-sm">
                                <p class="text-[10px] text-red-600 font-bold mb-1 uppercase tracking-widest">Telat</p>
                                <p class="text-2xl font-extrabold text-red-800" id="stat-telat">0</p>
                            </div>
                            <div class="bg-purple-50 border border-purple-100 p-3 rounded-xl text-center shadow-sm">
                                <p class="text-[10px] text-purple-600 font-bold mb-1 uppercase tracking-widest">Izin</p>
                                <p class="text-2xl font-extrabold text-purple-800" id="stat-izin">0</p>
                            </div>
                        </div>

                        <!-- Filtered Data List & EXCEL BUTTON -->
                        <div class="bg-white border border-gray-100 rounded-2xl p-4 shadow-sm">
                            <div class="flex justify-between items-center border-b border-gray-100 pb-3 mb-3">
                                <h3 class="font-bold text-gray-800 text-sm">Daftar Kehadiran</h3>
                                <button onclick="exportToExcel()" class="bg-emerald-500 hover:bg-emerald-600 text-white text-xs font-bold px-3 py-1.5 rounded-lg shadow-sm transition flex items-center transform active:scale-95">
                                    <svg class="w-4 h-4 mr-1.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path></svg>
                                    Export Excel
                                </button>
                            </div>
                            <div id="admin-data-list" class="space-y-3 max-h-80 overflow-y-auto pr-2">
                                <!-- Admin data items injected here -->
                            </div>
                        </div>
                    </div>

                    <!-- SUB-VIEW: PENGATURAN ASN -->
                    <div id="admin-sec-pengaturan" class="fade-in hidden space-y-4">
                        
                        <!-- Form Pengaturan Jam Kerja -->
                        <div class="bg-white border border-gray-100 rounded-2xl p-4 shadow-sm overflow-x-auto">
                            <h3 class="font-bold text-gray-800 border-b border-gray-100 pb-2 mb-4 text-sm">Pengaturan Jadwal Per Hari</h3>
                            
                            <table class="w-full text-left border-collapse min-w-[500px] mb-4">
                                <thead>
                                    <tr class="text-[10px] text-gray-500 uppercase tracking-wide border-b border-gray-200">
                                        <th class="py-2 px-1">Hari</th>
                                        <th class="py-2 px-1 text-center">Aktif</th>
                                        <th class="py-2 px-1 text-center">Mulai Masuk</th>
                                        <th class="py-2 px-1 text-center">Batas Masuk</th>
                                        <th class="py-2 px-1 text-center">Mulai Pulang</th>
                                        <th class="py-2 px-1 text-center">Batas Pulang</th>
                                    </tr>
                                </thead>
                                <tbody id="jadwal-hari-list">
                                    <!-- Injected via JS -->
                                </tbody>
                            </table>

                            <button id="btn-save-settings" onclick="saveAppSettings()" class="w-full bg-blue-600 hover:bg-blue-700 text-white font-bold py-3 rounded-xl shadow-md transition text-sm flex justify-center items-center">
                                Simpan Pengaturan Jadwal
                            </button>
                        </div>

                        <!-- Form Tambah ASN -->
                        <div class="bg-white border border-gray-100 rounded-2xl p-4 shadow-sm">
                            <h3 class="font-bold text-gray-800 border-b border-gray-100 pb-2 mb-3 text-sm">Tambah/Edit Pegawai</h3>
                            <div class="space-y-3">
                                <div>
                                    <label class="text-[10px] font-bold text-gray-500 uppercase tracking-wide">NIP / Username</label>
                                    <input type="text" id="asn-nip" class="w-full border border-gray-300 rounded-lg p-2.5 text-sm focus:ring-2 focus:ring-blue-500 bg-gray-50 outline-none" placeholder="Masukkan NIP unik">
                                </div>
                                <div>
                                    <label class="text-[10px] font-bold text-gray-500 uppercase tracking-wide">Nama Lengkap</label>
                                    <input type="text" id="asn-nama" class="w-full border border-gray-300 rounded-lg p-2.5 text-sm focus:ring-2 focus:ring-blue-500 bg-gray-50 outline-none" placeholder="Nama Pegawai">
                                </div>
                                <div class="grid grid-cols-2 gap-3">
                                    <div>
                                        <label class="text-[10px] font-bold text-gray-500 uppercase tracking-wide">Unit Kerja</label>

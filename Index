        function getLocation(requireExact = true) {
            const statusText = document.getElementById('location-status'); const geoInfo = document.getElementById('geo-info');
            if (!navigator.geolocation) { if(requireExact) showToast("Browser tidak mendukung GPS", "error"); return; }
            if(statusText) statusText.innerHTML = '<span class="animate-pulse">📍 Mencari sinyal Satelit...</span>';
            if(geoInfo) geoInfo.innerText = "Mengunci koordinat lokasi...";

            function successCallback(position) {
                window.currentLat = position.coords.latitude; window.currentLng = position.coords.longitude;
                const acc = Math.round(position.coords.accuracy);
                
                if(statusText) { let accColor = acc <= 50 ? 'text-green-300' : 'text-yellow-300'; statusText.innerHTML = `📍 GPS Terkunci <span class="${accColor} ml-1 text-[10px]">(±${acc}m)</span>`; }
                if(geoInfo) geoInfo.innerText = `Koordinat: ${window.currentLat.toFixed(5)}, ${window.currentLng.toFixed(5)}`;

                const profile = window.masterASN.find(m => m.nip === window.currentUser);
                if (profile && profile.lat && profile.lng && profile.radius) {
                    const jarak = hitungJarakMeter(window.currentLat, window.currentLng, parseFloat(profile.lat), parseFloat(profile.lng));
                    const distEl = document.getElementById('user-distance');
                    if(distEl) {
                        const jrkRound = Math.round(jarak); 
                        if (jrkRound <= parseFloat(profile.radius)) {
                            distEl.innerText = `${jrkRound.toLocaleString('id-ID')} m (Aman)`; distEl.className = "text-xs font-bold text-green-600 bg-green-100 px-2 py-1 rounded shadow-sm border border-green-200";
                        } else {
                            distEl.innerText = `${jrkRound.toLocaleString('id-ID')} m (Di luar pagar)`; distEl.className = "text-xs font-bold text-red-600 bg-red-100 px-2 py-1 rounded shadow-sm border border-red-200";
                        }
                    }
                }
            }

            function errorCallback(error) {
                let msg = "Gagal mengambil lokasi.";
                if (error.code === 1) msg = "Akses GPS ditolak browser/HP."; else if (error.code === 2) msg = "Sinyal GPS hilang/lemah."; else if (error.code === 3) msg = "Pencarian GPS Timeout.";
                if(statusText) statusText.innerHTML = '<span class="text-red-300">📍 GPS Error</span>';
                if(geoInfo) geoInfo.innerText = msg;
                if(requireExact) showToast(msg, "error");
            }
            navigator.geolocation.getCurrentPosition(successCallback, errorCallback, { enableHighAccuracy: true, timeout: 15000, maximumAge: 0 });
        }

        function hitungJarakMeter(lat1, lon1, lat2, lon2) {
            const R = 6371e3; const p1 = lat1 * Math.PI/180; const p2 = lat2 * Math.PI/180;
            const dp = (lat2-lat1) * Math.PI/180; const dl = (lon2-lon1) * Math.PI/180;
            const a = Math.sin(dp/2) * Math.sin(dp/2) + Math.cos(p1) * Math.cos(p2) * Math.sin(dl/2) * Math.sin(dl/2);
            return R * (2 * Math.atan2(Math.sqrt(a), Math.sqrt(1-a))); 
        }


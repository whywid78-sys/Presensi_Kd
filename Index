        async function uploadExcelASN() {
            const fileInput = document.getElementById('upload-excel-asn');
            const file = fileInput.files[0];
            if (!file) { showToast("Pilih file Excel terlebih dahulu!", "error"); return; }

            const btn = document.getElementById('btn-upload-excel');
            const btnSpan = document.getElementById('text-btn-upload');
            const spinner = document.getElementById('spinner-upload-excel');
            
            btn.disabled = true; btnSpan.innerText = "Memproses..."; spinner.classList.remove('hidden');

            const reader = new FileReader();
            reader.onload = async function(e) {
                try {
                    const data = new Uint8Array(e.target.result);
                    const workbook = XLSX.read(data, {type: 'array'});
                    const firstSheet = workbook.SheetNames[0];
                    const worksheet = workbook.Sheets[firstSheet];
                    const json = XLSX.utils.sheet_to_json(worksheet);

                    if (json.length === 0) { throw new Error("Data Excel Kosong / Format Salah"); }

                    let successCount = 0;
                    for (let i = 0; i < json.length; i++) {
                        const row = json[i];
                        
                        // Fitur Cerdas untuk mendeteksi variasi nama Kolom
                        const getVal = (key) => {
                            const foundKey = Object.keys(row).find(k => k.toLowerCase().replace(/ /g, '') === key.toLowerCase());
                            return foundKey ? String(row[foundKey]).trim() : '';
                        };

                        const nip = getVal('nip') || getVal('username');
                        const nama = getVal('nama') || getVal('namalengkap');
                        const unitKerja = getVal('unitkerja') || getVal('unit') || '';
                        const role = (getVal('role') || 'user').toLowerCase();
                        const password = getVal('password') || getVal('pass') || '123456';
                        const lat = getVal('lat') || getVal('latitude') || '';
                        const lng = getVal('lng') || getVal('longitude') || '';
                        let radius = getVal('radius') || '';

                        if (!nip || !nama) continue; // Melewati baris kosong atau tanpa NIP/Nama
                        if (lat && lng && !radius) radius = "100";

                        const payload = { nip, nama, unitKerja, role, password, lat, lng, radius };
                        
                        await firebaseCall('simpanDataASN', payload);
                        
                        let idx = window.masterASN.findIndex(m => String(m.nip) === String(nip));
                        if(idx > -1) window.masterASN[idx] = payload; else window.masterASN.push(payload);
                        
                        successCount++;
                    }

                    renderAdminASNList(); populateUnitFilter(); fileInput.value = ''; updateFileName(fileInput);
                    showToast(`Berhasil menyimpan ${successCount} data pegawai!`, "success");
                } catch (err) {
                    showToast("Gagal: " + err.message, "error");
                } finally {
                    btn.disabled = false; btnSpan.innerText = "Upload & Simpan Data"; spinner.classList.add('hidden');
                }
            };
            reader.readAsArrayBuffer(file);
        }


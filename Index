        function exportToExcel() {
            if (window.currentFilteredData.length === 0) { showToast("Tidak ada data untuk diekspor", "error"); return; }
            
            const startStr = document.getElementById('filter-start').value;
            const unitName = document.getElementById('filter-unit').options[document.getElementById('filter-unit').selectedIndex].text;
            
            const exportData = window.currentFilteredData.map((item, index) => {
                let ketPulang = "";
                let lokasiMasukStr = item.lokasiMasuk || "-";
                
                if (item.status.includes('Izin')) {
                    ketPulang = "Sesuai Izin";
                    lokasiMasukStr = `Keterangan: ${item.lokasiMasuk}`; 
                } else if(item.jamPulang) {
                    const itemDay = new Date(item.tanggal).getDay();
                    const jadwalItem = getJadwalHariIni(itemDay);

                    const [pJ, pM] = item.jamPulang.split(':').map(Number);
                    const [batasPulangJ, batasPulangM] = (jadwalItem.pulangMulai || '16:00').split(':').map(Number);
                    ketPulang = ((pJ * 60 + pM) < (batasPulangJ * 60 + batasPulangM)) ? "Pulang Awal" : "Sesuai Aturan";
                }

                return {
                    "No": index + 1, "Nama Lengkap": item.namaBaru, "NIP": item.username, "Unit Kerja": item.unitBaru,
                    "Tanggal": item.tanggal, "Jam Masuk": item.jamMasuk || "-", "Status Masuk": item.status, "Lokasi GPS / Keterangan": lokasiMasukStr,
                    "Jam Pulang": item.jamPulang || "-", "Status Pulang": ketPulang || "-", "Lokasi GPS Pulang": item.lokasiPulang || "-"
                };
            });

            const ws = XLSX.utils.json_to_sheet(exportData);
            const wb = XLSX.utils.book_new(); 
            XLSX.utils.book_append_sheet(wb, ws, "Laporan");
            XLSX.writeFile(wb, `Log_Presensi_${unitName}_${startStr}.xlsx`);
        }

        async function saveASN() {
            const nip = document.getElementById('asn-nip').value.trim(); const nama = document.getElementById('asn-nama').value.trim();
            const unit = document.getElementById('asn-unit').value.trim(); const role = document.getElementById('asn-role').value;
            const password = document.getElementById('asn-password').value.trim();
            const lat = document.getElementById('asn-lat').value.trim(); const lng = document.getElementById('asn-lng').value.trim();
            let radius = document.getElementById('asn-radius').value.trim();

            if(!nip || !nama || !unit || !password) { showToast("Kolom identitas wajib diisi!", "error"); return; }
            if (lat && lng && !radius) radius = "100";

            const payload = { nip, nama, unitKerja: unit, role, password, lat, lng, radius };
            showBtnLoading('btn-save-asn', true, "Menyimpan...");

            try {

        }

        async function submitPresensi() {
            if (!window.currentPhotoData) { showToast("Gagal memproses foto!", "error"); return; }
            if (!window.currentLat || !window.currentLng) { showToast("Sinyal GPS belum terkunci, tunggu sejenak.", "error"); return; }

            const now = new Date(); const currentDay = now.getDay(); const jadwalHariIni = getJadwalHariIni(currentDay);
            if (!jadwalHariIni.aktif) { showToast("Ditolak: Bukan hari efektif kerja!", "error"); return; }

            const profile = window.masterASN.find(m => m.nip === window.currentUser);
            if (profile && profile.lat && profile.lng && profile.radius) {
                const jarak = hitungJarakMeter(window.currentLat, window.currentLng, parseFloat(profile.lat), parseFloat(profile.lng));
                if (jarak > parseFloat(profile.radius)) { showToast(`DITOLAK: Jarak Anda (${Math.round(jarak)}m) di luar batas izin!`, "error"); return; }
            }

            const j = now.getHours(); const m = now.getMinutes(); const timeStr = `${String(j).padStart(2,'0')}:${String(m).padStart(2,'0')}:${String(now.getSeconds()).padStart(2,'0')}`;
            const todayStr = getTodayDateString(); let statusLog = "-"; const menitSkrg = (j * 60) + m;
            
            if (window.currentType === 'masuk') {
                const [mJ, mM] = (jadwalHariIni.masukMulai).split(':').map(Number); const [aJ, aM] = (jadwalHariIni.masukAkhir).split(':').map(Number);
                if (menitSkrg < (mJ * 60) + mM) { showToast(`Sistem belum menerima absen masuk!`, "error"); return; }
                statusLog = (menitSkrg > (aJ * 60) + aM) ? "Terlambat" : "Tepat Waktu";
            } else {
                const [pJ, pM] = (jadwalHariIni.pulangMulai).split(':').map(Number); const [aJ, aM] = (jadwalHariIni.pulangAkhir).split(':').map(Number);
                if (menitSkrg < (pJ * 60) + pM) { showToast(`Sistem pulang belum dibuka!`, "error"); return; }
                if (menitSkrg > (aJ * 60) + aM) { showToast(`Batas absen pulang terlewat!`, "error"); return; }
            }

            const payload = { id: now.getTime().toString(), username: window.currentUser, tanggal: todayStr, waktu: timeStr, tipe: window.currentType, lokasi: `${window.currentLat.toFixed(6)}, ${window.currentLng.toFixed(6)}`, status: statusLog, foto: window.currentPhotoData };
            const btnSubmit = document.getElementById('btn-submit'); const btnSpan = btnSubmit.querySelector('span'); const spinner = document.getElementById('submit-spinner');
            
            btnSubmit.disabled = true; btnSpan.innerText = "Mengirim..."; spinner.classList.remove('hidden');

            try {
                const res = await firebaseCall('simpanDataPresensi', payload);
                if(res.success) { showToast("Presensi Cloud Berhasil!", "success"); await fetchDataFromServer(); closeCamera(); } 
                else { showToast(res.message, "error"); }
            } catch (err) { showToast("Koneksi Cloud Gagal!", "error"); } 
            finally { btnSubmit.disabled = false; btnSpan.innerText = "Kirim Data"; spinner.classList.add('hidden'); }
        }

        // ====================================================================
        // UTILITIES
        // ====================================================================
        function getTodayDateString() {
            const now = new Date(); const yyyy = now.getFullYear(); const mm = String(now.getMonth() + 1).padStart(2, '0'); const dd = String(now.getDate()).padStart(2, '0');
            return `${yyyy}-${mm}-${dd}`;
        }

        let toastTimeout;
        function showToast(msg, type) {
            const toast = document.getElementById('toast'); toast.innerText = msg; 
            toast.className = `toast show ${type === 'success' ? 'toast-success' : 'toast-error'}`;
            clearTimeout(toastTimeout); toastTimeout = setTimeout(() => { toast.classList.remove('show'); }, 3500);
        }

        function showBtnLoading(btnId, isLoading, text) {
            const btn = document.getElementById(btnId); if(!btn) return; btn.disabled = isLoading;
            const spinner = document.getElementById(btnId === 'btn-login-submit' ? 'login-spinner' : 'submit-spinner');
            if(btnId === 'btn-login-submit') { document.getElementById('login-text').innerText = text; if(spinner) isLoading ? spinner.classList.remove('hidden') : spinner.classList.add('hidden'); } 
            else { btn.innerText = text; }
        }

        function animateValue(id, start, end, duration) {
            if (start === end) return; let range = end - start; let current = start; let increment = end > start ? 1 : -1;
            let stepTime = Math.abs(Math.floor(duration / range)); let obj = document.getElementById(id);
            let timer = setInterval(function() { current += increment; obj.innerHTML = current; if (current == end) { clearInterval(timer); } }, stepTime);
        }

        // Ekspos Fungsi ke Global Scope (Karena menggunakan type="module")
        Object.assign(window, { login, logout, openCamera, closeCamera, takeSnapshot, retakePhoto, submitPresensi, bukaModalIzin, tutupModalIzin, submitIzin, prosesBuktiIzin, handleFallbackCamera, switchAdminTab, applyAdminFilter, exportToExcel, saveASN, cancelEditASN, editASN, hapusASN, toggleRowJadwal, saveAppSettings, resetData, downloadTemplateExcel, updateFileName, uploadExcelASN, renderAdminASNList });
    </script>
</body>

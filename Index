        // ====================================================================
        async function login() {
            const user = document.getElementById('login-username').value.trim();
            const pass = document.getElementById('login-password').value.trim();
            
            if (!user || !pass) { showToast('NIP dan Password tidak boleh kosong!', 'error'); return; }
            
            try {
                showBtnLoading('btn-login-submit', true, "Memverifikasi...");
                await fetchDataFromServer();
                
                const pegawai = window.masterASN.find(m => String(m.nip) === user && String(m.password) === pass);
                
                if (pegawai) {
                    window.currentUser = user; window.currentRole = pegawai.role || 'user';
                    finalizeLogin();
                } else if (user === 'admin' && pass === 'admin') { 
                    window.currentUser = 'admin'; window.currentRole = 'admin';
                    finalizeLogin();
                } else {
                    showToast('NIP atau Password salah!', 'error');
                    showBtnLoading('btn-login-submit', false, "Masuk ke Sistem");
                }
            } catch (err) {
                console.error(err);
                let errMsg = err.message;
                
                if (errMsg.includes("permission") || errMsg.includes("Missing or insufficient permissions")) {
                    errMsg = "🔥 Akses Ditolak: Rules Firestore masih memblokir! Ubah ke allow read, write: if true;";
                } else if (errMsg.includes("Belum Login Firebase") || errMsg.includes("auth/operation-not-allowed")) {
                    errMsg = "🔥 ERROR: Autentikasi Anonim di Firebase belum aktif!";
                } else if (errMsg === "TIMEOUT_DB") {
                    errMsg = "🔥 TIMEOUT: Database Firestore belum di-Create atau Server Down!";
                }
                
                showToast(errMsg, "error");
                showBtnLoading('btn-login-submit', false, "Coba Lagi");
            }
        }

